@page "/"
@inject IHttpContextAccessor Context
@inject santa.Application.GameService Games
@using santa.Application
@using santa.Infrastructure
<PageTitle>Тайный Санта</PageTitle>
<ErrorMessage />
@if (Context.HttpContext!.User.Identity?.IsAuthenticated == true)
{
    <header class="page-heading"><h1>Мои игры</h1><p class="hint">Здесь игры, которые вы создали или в которых участвуете.</p></header>
    <div class="dashboard">
        <section class="game-list" aria-label="Мои игры">
        @if (games.Length == 0) {
            <div class="empty-state"><WinterIllustration Variant="gifts" /><h2>Пока нет игр</h2><p>Создайте первую или попросите организатора добавить ваш email.</p></div>
        }
        @foreach (var game in games) {
            <a class="game-card" href="@($"/games/{game.Id}")"><span class="game-card-icon" aria-hidden="true">✳</span><span class="game-card-content"><span class="game-title">@game.Title</span><StatusBadge State="@game.State" /></span><span class="game-open" aria-hidden="true">›</span></a>
        }
        </section>
        <section class="panel create-panel"><span class="paper-corner" aria-hidden="true">✳</span><h2>Новая игра</h2><form method="post" action="/actions/create" data-enhance="false">
            <AntiforgeryToken /><FormField For="title" Label="Название"><input id="title" name="title" required maxlength="150" placeholder="Например, Новый год с друзьями" /></FormField>
            <ActionButton type="submit">Создать игру</ActionButton>
        </form></section>
    </div>
}
else
{
    <section class="welcome" aria-labelledby="welcome-title">
        <div class="welcome-copy"><h1 id="welcome-title">Тайный<br /> Санта</h1><p class="intro">Соберите своих. Остальное — дело случая.</p><p class="welcome-description">Создайте игру, добавьте участников и проведите жеребьёвку. Каждый увидит, кому дарит подарок.</p><div class="actions"><a class="button" href="/register">Создать аккаунт</a><a class="text-link" href="/login">Уже играете? Войти</a></div></div>
        <div class="mail-scene" aria-hidden="true">
            <span class="mail-spark spark-one">✳</span><span class="mail-spark spark-two">✧</span>
            <div class="postcard"><span class="postcard-caption">Кому-то очень хорошему</span><img src="images/holiday-parcel.svg" alt="" width="320" height="240" /><span class="postcard-signature">От вашего Санты</span></div>
            <div class="envelope"><span class="envelope-label">Лично в руки</span><span class="wax-seal">с</span></div>
            <span class="mail-note">Имя внутри. Тс-с!</span>
        </div>
    </section>
    <section class="how-it-works" aria-labelledby="how-title">
        <h2 id="how-title">Как всё<br /> устроено</h2>
        <ol class="steps-list">
            <li><span class="step" aria-hidden="true">1</span><div><h3>Соберите компанию</h3><p>Участникам нужно зарегистрироваться. Организатор добавляет их по email.</p></div></li>
            <li><span class="step" aria-hidden="true">2</span><div><h3>Укажите исключения</h3><p>Выберите пары, которые не должны дарить друг другу.</p></div></li>
            <li><span class="step" aria-hidden="true">3</span><div><h3>Узнайте получателя</h3><p>После жеребьёвки каждый увидит только своего получателя.</p></div></li>
        </ol>
    </section>
}

@code {
    private GameView[] games = [];
    protected override async Task OnInitializedAsync()
    {
        if (Context.HttpContext!.User.Identity?.IsAuthenticated == true)
            games = await Games.List(WebEndpoints.Actor(Context.HttpContext.User));
    }
    public static string StateName(string state) => state switch { "Draft" => "Подготовка", "Published" => "Результаты доступны", _ => "Завершена" };
}
