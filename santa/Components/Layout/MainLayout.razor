@inherits LayoutComponentBase
@inject IHttpContextAccessor Context
<a class="skip-link" href="#main">Перейти к содержимому</a>
<header class="site-header"><nav aria-label="Главное меню">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">✳</span><span>Тайный Санта</span></a>
    @if (Context.HttpContext?.User.Identity?.IsAuthenticated == true) {
        <form method="post" action="/account/logout" data-enhance="false"><AntiforgeryToken /><ActionButton Class="secondary compact" type="submit">Выйти</ActionButton></form>
    } else { <a class="nav-link" href="/login">Войти</a> }
</nav></header>
<main id="main">@Body</main>
<div id="blazor-error-ui" role="alert">Произошла ошибка. <a href="" class="reload">Обновить страницу</a></div>
